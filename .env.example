# ─── Autenticação ────────────────────────────────────────────────────────────
# Escolha UM dos dois mecanismos. Bearer tem precedência sobre Basic.

# Bearer Token
SIENGE_API_KEY=

# Basic Auth (exige também SIENGE_SUBDOMAIN)
SIENGE_USERNAME=
SIENGE_PASSWORD=

# Subdomínio da sua empresa no Sienge — compõe a URL de toda chamada.
SIENGE_SUBDOMAIN=

# ─── Compras ─────────────────────────────────────────────────────────────────
# Usuário do Sienge que assina as solicitações de compra criadas por aqui. A
# API exige um solicitante e não o deduz da credencial, então sem isso
# compras_criar_solicitacao recusa antes de chamar a API. Não é o mesmo que
# SIENGE_USERNAME: a credencial autentica, este assina.
SIENGE_SOLICITANTE=

# Usuário responsável pelo CADASTRO da solicitação, nas informações de
# controle do Sienge. Campo separado do solicitante — um pede, o outro
# registra — e a API recusa a criação quando ele chega nulo. Vazio = usa o
# SIENGE_SOLICITANTE, que é o caso normal. Preencha só quando o usuário da
# integração for outro; ele precisa ter permissão na obra da solicitação.
SIENGE_CADASTRANTE=

# Departamento e categoria da solicitação. O spec os declara opcionais, mas a
# parametrização do Sienge pode exigi-los — se a criação for recusada citando
# um deles, preencha aqui em vez de relaxar a regra no ERP. Vazios, não são
# enviados.
SIENGE_DEPARTAMENTO=
SIENGE_CATEGORIA=

# Nível da EAP em que esta obra apropria, contado pelos segmentos do código do
# item de orçamento: "02.032" é nível 2, "01.001.000.001" é nível 4. É
# parametrização do Sienge, não preferência — apropriar noutro nível é erro de
# cadastro. Configurado, restringe o casamento aos itens daquele nível e deixa
# a lista de opções pequena o bastante para o assistente escolher sozinho.
# Vazio = todos os níveis valem.
SIENGE_NIVEL_APROPRIACAO=

# ─── Servidor ────────────────────────────────────────────────────────────────
SIENGE_BASE_URL=https://api.sienge.com.br

# ─── Recorte do catálogo de tools ────────────────────────────────────────────
# Vazio = só o núcleo, e o modelo carrega o resto com carregar_<modulo>
# conforme precisar. Ou fixe os módulos que sua operação usa sempre:
# "compras,financeiro". Um módulo inexistente é ignorado, com aviso no stderr.
# Módulos disponíveis hoje: compras, financeiro
SIENGE_PROFILE=
