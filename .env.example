# ─── Autenticação ────────────────────────────────────────────────────────────
# Escolha UM dos dois mecanismos. Bearer tem precedência sobre Basic.

# Bearer Token
SIENGE_API_KEY=

# Basic Auth (exige também SIENGE_SUBDOMAIN)
SIENGE_USERNAME=
SIENGE_PASSWORD=

# Subdomínio da sua empresa no Sienge — compõe a URL de toda chamada.
SIENGE_SUBDOMAIN=

# ─── Servidor ────────────────────────────────────────────────────────────────
SIENGE_BASE_URL=https://api.sienge.com.br
REQUEST_TIMEOUT=30

# ─── Recorte do catálogo de tools ────────────────────────────────────────────
# Vazio = só o núcleo, e o modelo carrega o resto com carregar_<modulo>
# conforme precisar. "all" deixa tudo visível de saída; ou fixe os módulos
# que sua operação usa sempre: "compras,financeiro".
# Módulos: nucleo cadastros compras compras_api cotacoes financeiro contratos titulos
SIENGE_PROFILE=

# ─── Cota diária da API ──────────────────────────────────────────────────────
# Seu pacote contratado, para que o saldo diário seja calculado.
# free | start | special | essencial | enterprise | ultimate
SIENGE_MCP_API_PACKAGE=

# ─── Licença ─────────────────────────────────────────────────────────────────
SIENGE_MCP_LICENSE_KEY=

# ─── Estado local (opcional) ─────────────────────────────────────────────────
# Padrão: ~/.sienge-mcp/
# SIENGE_MCP_HOME=
# SIENGE_MCP_LOG_FILE=
# SIENGE_MCP_LOG_LEVEL=INFO
# SIENGE_MCP_AUDIT_LOG=
# SIENGE_MCP_QUOTA_COUNTER=
