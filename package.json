{
  "name": "mcp-sienge-node",
  "version": "0.5.1",
  "description": "Servidor MCP para a API do Sienge — consultas e operações do ERP expostas como ferramentas para assistentes de IA.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mcp-sienge-node": "src/index.js"
  },
  "files": [
    "src/",
    "contract/endpoints.json",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.js",
    "check": "node scripts/check-schemas.js",
    "endpoints": "node scripts/build-endpoints.js",
    "gen:schemas": "node scripts/generate-schemas.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sienge",
    "erp",
    "construcao-civil"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frlorenzon/MCP-Sienge-Node.git"
  },
  "homepage": "https://github.com/frlorenzon/MCP-Sienge-Node#readme",
  "bugs": {
    "url": "https://github.com/frlorenzon/MCP-Sienge-Node/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Felipe Ribeiro Lorenzon <frlorenzon@gmail.com>"
}
